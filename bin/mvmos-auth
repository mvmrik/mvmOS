#!/usr/bin/env python3
"""
mvmos-auth — setuid helper for password verification.
Reads /etc/shadow (requires root/setuid) and checks username:password from stdin.
Exits 0 if correct, 1 if wrong, 2 if user not found.
"""
import sys, spwd, crypt

try:
    line = sys.stdin.readline().rstrip('\n')
    username, password = line.split(':', 1)
    shadow = spwd.getspnam(username)
    ok = crypt.crypt(password, shadow.sp_pwdp) == shadow.sp_pwdp
    sys.exit(0 if ok else 1)
except KeyError:
    sys.exit(2)
except Exception:
    sys.exit(1)
